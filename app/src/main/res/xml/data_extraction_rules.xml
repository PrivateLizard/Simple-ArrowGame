<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the opt-in backup file may leave the device, and it stays
     empty unless the player switches "Backup" on in Settings (BackupMirror).
     Cloud backup only with end-to-end encryption. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="arrow_puzzle_backup.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="arrow_puzzle_backup.xml" />
    </device-transfer>
</data-extraction-rules>
