<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group>
        <!-- Rounded outer shape -->
        <clip-path
            android:pathData="M16,0 H92 A16,16 0 0 1 108,16 V92 A16,16 0 0 1 92,108 H16 A16,16 0 0 1 0,92 V16 A16,16 0 0 1 16,0 Z" />

        <!-- Light mode (top half) and dark mode (bottom half) -->
        <path
            android:fillColor="#F5F2EA"
            android:pathData="M0,0h108v54H0z" />
        <path
            android:fillColor="#0B1020"
            android:pathData="M0,54h108v54H0z" />

        <!--
            One continuous path split by the colour change at the divider:
            light head (left) <- shaft <- centre -> shaft -> dark head (right).
            Both arrows therefore meet at the centre line.
        -->

        <!-- Light arrow: shaft + triangular head pointing left -->
        <path
            android:pathData="M54,28 L40,28"
            android:strokeColor="#1D3557"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#1D3557"
            android:pathData="M20,28 L40,17 L40,39 Z" />

        <!-- Dark arrow: shaft + triangular head pointing right -->
        <path
            android:pathData="M54,80 L68,80"
            android:strokeColor="#39D98A"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#39D98A"
            android:pathData="M88,80 L68,69 L68,91 Z" />

        <!-- Connector joining both arrow tails across the light/dark divider -->
        <path
            android:pathData="M54,28 L54,54"
            android:strokeColor="#1D3557"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M54,54 L54,80"
            android:strokeColor="#39D98A"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
    </group>
</vector>
